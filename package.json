{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server-entry.ts",
    "build": "cross-env NODE_ENV=production vite build && esbuild server-entry.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/worker.cjs && npm run build:owner-bootstrap",
    "build:owner-bootstrap": "esbuild scripts/bootstrap-initial-owner.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/bootstrap-initial-owner.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "worker": "cross-env NODE_ENV=production node dist/worker.cjs",
    "worker:dev": "tsx worker.ts",
    "clean": "node -e \"import { rm } from 'fs/promises'; await rm('dist', { recursive: true, force: true }); await rm('server.js', { force: true });\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security-rbac.test.ts",
    "route:attack": "node scripts/route-attack-test.mjs",
    "security:gate": "node scripts/security-hardening-check.mjs && node scripts/migration-hardening-check.mjs && node scripts/route-security-gate.mjs",
    "zip:full": "node scripts/make-full-zip.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/node": "^10.68.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "stripe": "^22.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^5.3.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "@esbuild-kit/esm-loader": {
      "esbuild": "0.28.1"
    },
    "uuid": "11.1.1",
    "retry-request": "8.0.4",
    "teeny-request": "10.1.4",
    "gaxios": "7.3.0"
  }
}
