# ── Backend (Railway) — set these in the Railway dashboard, not here ──
NODE_ENV=production
APP_URL=https://your-app.up.railway.app
APP_ALLOWED_ORIGINS=https://your-app.vercel.app
DATABASE_URL=                       # auto-injected by Railway's Postgres plugin
FIREBASE_SERVICE_ACCOUNT_KEY=       # full service-account JSON, one line
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=                         # optional
REDIS_URL=                          # Upstash connection string — see railway.toml notes
GOOGLE_GENAI_API_KEY=

# ── Owner bootstrap (run once via `railway run`, then delete) ──
SPR_INITIAL_OWNER_EMAIL=
SPR_OWNER_BOOTSTRAP_SECRET=
SPR_OWNER_BOOTSTRAP_SECRET_SHA256=

# ── Frontend (Vercel) — optional, falls back to firebase-applet-config.json ──
# Only needed if you want the Vercel build using different Firebase config
# than the committed firebase-applet-config.json (that file holds public
# client keys, which are safe to commit by design).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
