# Production backend — inject real values through the deployment secret manager.
NODE_ENV=production
APP_URL=https://your-app.example
APP_ALLOWED_ORIGINS=https://your-app.example
ENFORCE_HTTPS=true
TRUST_PROXY=true
ALLOW_IFRAME=false

# PostgreSQL: either DATABASE_URL or the complete SQL_* alternative.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
SQL_SSL=require

# Shared fail-closed rate limiting.
REDIS_URL=redis://USER:PASSWORD@HOST:6379
RATE_LIMIT_FAIL_OPEN=false

# Required production authentication/billing secrets.
FIREBASE_SERVICE_ACCOUNT_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional services.
GEMINI_API_KEY=
SENTRY_DSN=

# One-time Owner bootstrap; inject temporarily, run bootstrap, then remove.
SPR_INITIAL_OWNER_EMAIL=
SPR_OWNER_BOOTSTRAP_SECRET=
SPR_OWNER_BOOTSTRAP_SECRET_SHA256=

# Optional frontend Firebase public configuration.
# These are client-side configuration values, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
